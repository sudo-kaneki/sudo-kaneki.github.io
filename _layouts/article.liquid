---
layout: base
---
<article>
  <h1>{{ page.title }}</h1>
  <p class="cv-entry__when">
    {{ page.date | date: '%Y-%m-%d' }}
    {% for cat in page.categories -%}
      <span class="tag">{{ cat }}</span>
    {%- endfor %}
  </p>
  {{ content }}
</article>

<p><a href="{{ '/blog/' | relative_url }}">← all posts</a></p>
