{% comment %}
  Renders one section of _data/cv.yml.
  Expects: entries (array) and kind (string) — branch on `kind`, NOT on which
  content fields happen to exist. Discriminating on content silently drops
  entries that omit an optional field (a publication with no `authors` used to
  render with an empty title).
{% endcomment %}

{% assign entries = include.entries %}
{% assign kind = include.kind %}

{% for entry in entries %}
  <div class="cv-entry">
    <div class="cv-entry__head">
      {% case kind %}
        {% when 'experience' %}
          <span class="cv-entry__title">{{ entry.position }}</span>
        {% when 'education' %}
          <span class="cv-entry__title">{{ entry.degree }}, {{ entry.area }}</span>
        {% when 'publications' %}
          <span class="cv-entry__title">
            {% if entry.url %}
              <a href="{{ entry.url }}">{{ entry.title }}</a>
            {% else %}
              {{ entry.title }}
            {% endif %}
          </span>
        {% else %}
          <span class="cv-entry__title">{{ entry.label }}</span>
      {% endcase %}

      {% if entry.start_date %}
        <span class="cv-entry__when">
          {{ entry.start_date -}}
          {%- if entry.end_date %} — {{ entry.end_date }}{% endif %}
        </span>
      {% elsif entry.date %}
        <span class="cv-entry__when">{{ entry.date }}</span>
      {% endif %}
    </div>

    {% comment %}
      Employer / institution goes on its own muted line under the bold role,
      mirroring the homepage timeline — rather than chained into the title with
      " · ", which reads long and repeats the company when one role spans two
      project entries. Location rides on the same line.
    {% endcomment %}
    {% if kind == 'experience' %}
      <p class="cv-entry__meta">
        {{ entry.company -}}
        {%- if entry.location %} · {{ entry.location }}{% endif %}
      </p>
    {% elsif kind == 'education' %}
      <p class="cv-entry__meta">
        {{ entry.institution -}}
        {%- if entry.location %} · {{ entry.location }}{% endif %}
      </p>
    {% endif %}

    {% if kind == 'publications' and entry.authors %}
      <p class="cv-entry__meta">{{ entry.authors | join: ', ' | markdownify | remove: '<p>' | remove: '</p>' }}</p>
    {% endif %}

    {% if entry.journal %}
      <p class="cv-entry__meta">{{ entry.journal }}</p>
    {% endif %}
    {% if entry.details %}
      <p>{{ entry.details | markdownify | remove: '<p>' | remove: '</p>' }}</p>
    {% endif %}

    {% if entry.highlights %}
      <ul>
        {% for h in entry.highlights %}
          <li>{{ h | markdownify | remove: '<p>' | remove: '</p>' }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endfor %}
