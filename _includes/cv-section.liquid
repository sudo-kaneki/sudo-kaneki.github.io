{% comment %}
  Renders one section of _data/cv.yml.
  Expects: entries (array) and kind (string) — branch on `kind`, NOT on which
  content fields happen to exist. Discriminating on content silently drops
  entries that omit an optional field (a publication with no `authors` used to
  render with an empty title).
{% endcomment %}

{% assign entries = include.entries %}
{% assign kind = include.kind %}

{% for entry in entries %}
  <div class="cv-entry">
    <div class="cv-entry__head">
      {% case kind %}
        {% when 'experience' %}
          <span class="cv-entry__title">{{ entry.position }} · {{ entry.company }}</span>
        {% when 'education' %}
          <span class="cv-entry__title">{{ entry.degree }}, {{ entry.area }} · {{ entry.institution }}</span>
        {% when 'publications' %}
          <span class="cv-entry__title">
            {% if entry.url %}
              <a href="{{ entry.url }}">{{ entry.title }}</a>
            {% else %}
              {{ entry.title }}
            {% endif %}
          </span>
        {% else %}
          <span class="cv-entry__title">{{ entry.label }}</span>
      {% endcase %}

      {% if kind == 'experience' or kind == 'education' %}
        <span class="cv-entry__when">
          {{ entry.start_date -}}
          {%- if entry.end_date %} — {{ entry.end_date }}{% endif %}
        </span>
      {% elsif entry.date %}
        <span class="cv-entry__when">{{ entry.date }}</span>
      {% endif %}
    </div>

    {% if kind == 'publications' and entry.authors %}
      <p class="cv-entry__meta">{{ entry.authors | join: ', ' | markdownify | remove: '<p>' | remove: '</p>' }}</p>
    {% endif %}

    {% if entry.journal %}
      <p class="cv-entry__meta">{{ entry.journal }}</p>
    {% endif %}
    {% if entry.location %}
      <p class="cv-entry__meta">{{ entry.location }}</p>
    {% endif %}
    {% if entry.details %}
      <p>{{ entry.details | markdownify | remove: '<p>' | remove: '</p>' }}</p>
    {% endif %}

    {% comment %}
      Highlights may include project sub-headers: a highlight that is ENTIRELY
      bold (**...**) renders as a <p class="cv-subhead">, and the bullets after
      it group under it. Anything else is a normal bullet. Detection: markdownify
      the highlight, strip the wrapping <p>, and check it both starts with
      <strong> and ends with </strong> — i.e. the bold spans the whole line.
      We open and close <ul> around runs of bullets so a header can sit between
      two lists.
    {% endcomment %}
    {% if entry.highlights %}
      {% assign in_list = false %}
      {% for h in entry.highlights %}
        {% assign body = h | markdownify | remove: '<p>' | remove: '</p>' | strip %}
        {% assign lead = body | slice: 0, 8 %}
        {% assign tail = body | slice: -9, 9 %}
        {% if lead == '<strong>' and tail == '</strong>' %}
          {% if in_list %}
            </ul>
            {% assign in_list = false -%}
          {%- endif %}
          <p class="cv-subhead">{{ body }}</p>
        {% else %}
          {% unless in_list %}
            <ul>
              {% assign in_list = true -%}
          {%- endunless %}
          <li>{{ body }}</li>
        {% endif %}
      {% endfor %}
      {% if in_list %}</ul>{% endif %}
    {% endif %}
  </div>
{% endfor %}
