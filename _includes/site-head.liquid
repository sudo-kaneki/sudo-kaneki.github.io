<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{%- if page.url == '/' -%}
  {%- assign page_title = site.first_name | append: ' ' | append: site.last_name | append: ' · ' | append: site.data.cv.cv.headline -%}
{%- elsif page.title -%}
  {%- assign page_title = page.title | append: ' · ' | append: site.first_name | append: ' ' | append: site.last_name -%}
{%- else -%}
  {%- assign page_title = site.first_name | append: ' ' | append: site.last_name -%}
{%- endif -%}
<title>{{ page_title }}</title>
<meta name="description" content="{{ page.description | default: site.description | strip_newlines | strip }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ page.description | default: site.description | strip_newlines | strip }}">
<meta property="og:url" content="{{ page.url | replace: 'index.html', '' | absolute_url }}">
<meta property="og:site_name" content="{{ site.first_name }} {{ site.last_name }}">
<meta name="twitter:card" content="summary">
<meta name="color-scheme" content="dark light">
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
{% feed_meta %}

{% comment %}
  Favicon: the WB monogram from the nav, blinking like a terminal cursor.

  The blink is done by swapping this link's href on a timer (see
  favicon-blink.js), NOT by animating the SVG — Chrome rasterizes an SVG
  favicon once and never animates it, so SMIL/CSS animation inside the SVG
  would simply not blink for most visitors.

  The colours are hardcoded here and are the one sanctioned exception to the
  "_tokens.scss owns every literal" rule: an SVG data URI cannot read a CSS
  custom property. Keep %235ee2a0 and %230b0d0c in sync with --accent and
  --bg in _sass/_tokens.scss.
{% endcomment %}
<link
  rel="icon"
  id="favicon"
  type="image/svg+xml"
  href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%235ee2a0'/><text x='16' y='22' font-family='ui-monospace,SFMono-Regular,Menlo,monospace' font-size='15' font-weight='700' text-anchor='middle' fill='%230b0d0c'>WB</text></svg>"
>

<link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url }}">

<script>
  // Blocking on purpose: must run before first paint to avoid a
  // flash of the wrong theme. Dark is the default.
  (function () {
    var stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch (e) {}
    var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
    var theme = stored || (prefersLight ? 'light' : 'dark');
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>

{% if page.math %}
  <script>
    window.MathJax = {
      tex: {
        inlineMath: [
          ['$', '$'],
          ['\\(', '\\)'],
        ],
      },
    };
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
{% endif %}
