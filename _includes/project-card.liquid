<article class="card">
  <h3>{{ project.title }}</h3>
  <p>{{ project.blurb }}</p>
  {% if project.tags %}
    <p>
      {% for tag in project.tags -%}
        <span class="tag">{{ tag }}</span>
      {%- endfor %}
    </p>
  {% endif %}
  {% if project.links %}
    <p>
      {% for link in project.links %}
        <a href="{{ link.url }}">{{ link.label }}</a>
        {%- unless forloop.last %} · {% endunless %}
      {% endfor %}
    </p>
  {% endif %}
</article>
